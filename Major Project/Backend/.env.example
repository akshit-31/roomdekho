# Server Environment Variables (for Render / Production)
PORT=5000
NODE_ENV=production

# Supabase / PostgreSQL Connection String
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# JWT Secrets (Generate secure random strings)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Frontend URL (Your Vercel deployment URL)
CLIENT_URL=https://your-frontend-app.vercel.app
